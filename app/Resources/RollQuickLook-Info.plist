<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- The Quick Look preview extension (the space bar) inside FirstEdit.app
       (Contents/PlugIns/RollQuickLook.appex). Its identifier has to start
       with the app's, and its version is the app's: app/build.sh fills both
       placeholders from the same numbers. -->
  <key>CFBundleName</key><string>RollQuickLook</string>
  <key>CFBundleDisplayName</key><string>FirstEdit Packed Burst Previews</string>
  <key>CFBundleIdentifier</key><string>com.nickcupo.firstedit.roll-preview</string>
  <key>CFBundleExecutable</key><string>RollQuickLook</string>
  <key>CFBundlePackageType</key><string>XPC!</string>
  <key>CFBundleShortVersionString</key><string>__VERSION__</string>
  <key>CFBundleVersion</key><string>__BUILD__</string>
  <key>LSMinimumSystemVersion</key><string>15.0</string>
  <key>NSExtension</key><dict>
    <key>NSExtensionPointIdentifier</key><string>com.apple.quicklook.preview</string>
    <key>NSExtensionPrincipalClass</key><string>RollPreviewProvider</string>
    <key>NSExtensionAttributes</key><dict>
      <key>QLSupportedContentTypes</key><array><string>com.nickcupo.firstedit.roll</string></array>
      <key>QLIsDataBasedPreview</key><true/>
      <key>QLSupportsSearchableItems</key><false/>
    </dict>
  </dict>
</dict></plist>
