<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- Hardened runtime, with what a bundled CPython and torch need.
       There is no app-sandbox key and there cannot be one: the app's whole job
       is to spawn the interpreter it ships and hand it a folder of RAW files.
       RELEASING.md says why, so the question is answered before it is asked. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict></plist>
